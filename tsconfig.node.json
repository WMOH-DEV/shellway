{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "./out",
    "target": "ESNext",
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "electron/**/*.ts",
    "electron.vite.config.ts",
    "src/types/**/*.ts",
    "src/search/cachePatch.ts",
    "src/utils/deploy/githubRepo.ts",
    "src/utils/deploy/presets.ts",
    "src/utils/deploy/siteDetail.ts",
    "src/utils/createSite/**/*.ts",
    "src/utils/deploy/siteRow.ts",
    "src/utils/deploy/siteStatus.ts",
    "src/utils/ssl/time.ts",
    "src/utils/ssl/verdict.ts",
    "src/utils/ssl/commands.ts",
    "src/utils/ssl/renewalHint.ts",
    "src/utils/ssl/https/**/*.ts",
    "src/utils/ssl/originCa/**/*.ts",
    "src/utils/webServer/**/*.ts",
    "src/utils/server/**/*.ts",
    "src/utils/ssl/testReport.ts",
    "package.json"
  ]
}
